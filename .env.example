NEXT_PUBLIC_API_BASE_URL=
NEXT_PUBLIC_USE_MOCK=true
# Keep host runtime data outside the Git checkout.
# macOS/Linux example: DATA_DIR=/UED-Asset-Hub-Storage/data
# Windows example: DATA_DIR=D:/UED-Asset-Hub/runtime-data
DATA_DIR=/UED-Asset-Hub-Storage/data
# Only files inside this directory can be associated with Training Library.
# Windows example: TRAINING_MEDIA_DIR=D:/UED-Asset-Hub/training-media
TRAINING_MEDIA_DIR=/UED-Asset-Hub-Storage/training-media
# Youding Agent keeps DSH runtime data outside both the Git checkout and DATA_DIR.
# Windows example: AGENT_RUNTIME_DIR=D:/UED-Asset-Hub/agent-data
AGENT_RUNTIME_DIR=/UED-Asset-Hub-Storage/agent-data
AGENT_ENABLED=true
# Fixed-version DSH source must stay outside this Git checkout.
# Windows example: DSH_SOURCE_DIR=D:/UED-Asset-Hub-DSH/deepseek-harness
DSH_SOURCE_DIR=/UED-Asset-Hub-DSH/deepseek-harness
# Must remain a loopback URL. DSH must not be exposed directly to the LAN.
DSH_BASE_URL=http://127.0.0.1:3080
# Agent Proxy remains loopback-only. Host Runner forwards /agent-runtime through Asset Hub.
AGENT_PROXY_PORT=3081
AGENT_PROXY_HOST=127.0.0.1
# Asset Hub is the only user-facing service.
HOST_BIND_HOST=0.0.0.0
HOST_PORT=3027
HOST_INTERNAL_PORT=3028
# Server-only encryption secret for test environment passwords.
TEST_ENV_ENCRYPTION_KEY=
# Admin credentials and session signing stay on the server. Do not use NEXT_PUBLIC_ variables here.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
# Use a long random value in a shared environment.
ADMIN_SESSION_SECRET=
# Set true only when the server is accessed through HTTPS.
ADMIN_SESSION_SECURE=false

OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=

NEXT_PUBLIC_STORAGE_PROVIDER=local
NEXT_PUBLIC_OSS_BUCKET=
NEXT_PUBLIC_OSS_REGION=
