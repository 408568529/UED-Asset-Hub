<!-- WinSW 2.12.0 x64. Render {{UED_ROOT}} during controlled Windows deployment. Never put a secret in this file. -->
<service>
  <id>UEDAssetHub</id>
  <name>UED Asset Hub</name>
  <description>UED Asset Hub Host Supervisor</description>
  <executable>{{UED_ROOT}}\service\node\22.23.2\node.exe</executable>
  <startarguments>{{UED_ROOT}}\current\scripts\start-host.mjs</startarguments>
  <stopexecutable>{{UED_ROOT}}\service\node\22.23.2\node.exe</stopexecutable>
  <stoparguments>{{UED_ROOT}}\current\scripts\windows-managed-shutdown-client.mjs 90000</stoparguments>
  <workingdirectory>{{UED_ROOT}}\current</workingdirectory>
  <env name="UED_WINDOWS_SERVICE_MODE" value="true" />
  <env name="UED_WINSW_EXECUTABLE" value="{{UED_ROOT}}\service\UEDAssetHub.exe" />
  <env name="HOST_BIND_HOST" value="127.0.0.1" />
  <stoptimeout>120 sec</stoptimeout>
  <onfailure action="restart" delay="30 sec" />
  <onfailure action="restart" delay="60 sec" />
  <onfailure action="restart" delay="5 min" />
  <onfailure action="none" />
  <resetfailure>1 hour</resetfailure>
  <logpath>{{UED_ROOT}}\logs\winsw</logpath>
  <log mode="roll" />
</service>
