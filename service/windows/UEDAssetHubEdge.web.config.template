<configuration>
  <system.webServer>
    <webSocket enabled="true" />
    <proxy enabled="true" preserveHostHeader="true" reverseRewriteHostInResponseHeaders="false" />
    <rewrite>
      <rules>
        <rule name="UED Asset Hub loopback upstream" stopProcessing="true">
          <match url="(.*)" />
          <action type="Rewrite" url="http://127.0.0.1:3027/{R:1}" />
        </rule>
      </rules>
    </rewrite>
  </system.webServer>
</configuration>
